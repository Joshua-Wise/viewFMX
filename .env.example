# API Configuration
VITE_API_BASE_URL=/api/v1
GOFMX_TOKEN=your_token_here
VITE_GOFMX_STATUS=FinalizedUpcoming
NGINX_PROXY_PASS=https://your-domain.gofmx.com/api/v1/
NGINX_PROXY_HOST=your-domain.gofmx.com

# Host port the UI is published on.
UI_PORT=3030

# Note: the VITE_* values above are compiled into the SPA bundle at image
# build time, so for the published GHCR image they come from this repo's
# Actions variables (see .github/workflows/build.yml), not from this file.
# GOFMX_TOKEN, NGINX_PROXY_PASS and NGINX_PROXY_HOST are read at container
# start and are never baked into the image.
